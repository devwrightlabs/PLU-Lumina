LUMINA_JWT_SECRET=change-me-to-a-long-random-secret
PI_API_KEY=your-pi-network-server-api-key

# Set to "true" to use Pi Testnet contracts and Soroban RPC instead of mainnet
LUMINA_SANDBOX=true

# Soroban operator key used to sign on-chain vault deposit invocations.
# Generate with: stellar keys generate --network testnet lumina-operator
# Must be funded on the target network (testnet or mainnet).
PI_VAULT_OPERATOR_SECRET=S...

# Optional overrides — defaults derived from LUMINA_SANDBOX if omitted
# PI_VAULT_CONTRACT=C...
# PI_SOROBAN_RPC_URL=https://soroban-rpc.testnet.minepi.com
# PI_NETWORK_PASSPHRASE=Pi Testnet ; December 2019
# PI_HORIZON_URL=https://api.testnet.minepi.com
